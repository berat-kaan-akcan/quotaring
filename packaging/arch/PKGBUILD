# Arch / CachyOS package built from this repository's source (uses system Python + PySide6).
# Build:  ./packaging/arch/build.sh      (creates the source tarball, then runs makepkg)
# Maintainer: Berat Kaan Akcan <beratkaanakcan@gmail.com>
pkgname=quotaring
pkgver=0.2.2
pkgrel=1
pkgdesc="Desktop widget for Claude Code, Codex and Antigravity usage"
arch=('any')
license=('MIT')
depends=('python' 'pyside6')
optdepends=('layer-shell-qt: open the popup by the panel on Wayland (else XWayland is used)')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/usr/share/$pkgname"
  cp -r quotaring "$pkgdir/usr/share/$pkgname/"
  python -m compileall -q "$pkgdir/usr/share/$pkgname/quotaring"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<'SH'
#!/bin/sh
exec /usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/share/quotaring"); from quotaring.app import main; sys.exit(main())' "$@"
SH
  install -Dm644 packaging/linux/quotaring.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  for s in 16 32 48 64 128 256; do
    install -Dm644 "packaging/icons/quotaring-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$pkgname.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
